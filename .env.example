# ==============================================================================
# AGENTIC API - Environment Variables Template
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY: copy this file to '.env' and fill in the values.
# Never commit '.env' or real credentials to version control (see FINDING-001).
#
# Kubernetes deployments do NOT use this file. The same variables are supplied
# by the cluster instead:
#   * non-sensitive values -> ConfigMap 'agentic-api-config' (k8s/configmap.yaml)
#   * secrets (API keys)   -> Secret 'agentic-api-secrets', created at deploy
#                             time with `kubectl create secret` (see README.md)
# Keep those sources consistent with this template.
#
# Every variable below is [REQUIRED] unless marked [OPTIONAL].
# ==============================================================================

# ------------------------------------------------------------------------------
# FASTAPI (env prefix: FASTAPI_)
# ------------------------------------------------------------------------------
# [REQUIRED] API key guarding the authenticated /api/v1 endpoints.
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# [LOCAL DEVELOPMENT ONLY] Do not use it in production
FASTAPI_API_KEY=change-me-strong-random-key

# [OPTIONAL] Show the interactive Swagger docs (set False in production)
FASTAPI_DOCS=True

# [REQUIRED] Base path for the FastAPI docs endpoint
FASTAPI_DOCS_URL=docs

# [OPTIONAL] Show the ReDoc documentation page (set False in production)
FASTAPI_REDOC=True

# [OPTIONAL] Base path for the FastAPI redoc endpoint
FASTAPI_REDOC_URL=redoc

# [OPTIONAL] Host the web server binds to (use 0.0.0.0 inside containers/Pods)
FASTAPI_HOST=127.0.0.1

# [OPTIONAL] Port the web server binds to
FASTAPI_PORT=8000

# [REQUIRED] JSON array of allowed CORS origins
FASTAPI_CORS_ORIGINS=["127.0.0.1"]

# [REQUIRED] JSON array of allowed CORS methods
FASTAPI_CORS_METHODS=["GET","POST"]

# [REQUIRED] JSON array of allowed CORS headers
FASTAPI_CORS_HEADERS=["x-api-key","content-type"]

# ------------------------------------------------------------------------------
# AGENT (env prefix: AGENT_)
# ------------------------------------------------------------------------------
# [REQUIRED] API key required to authenticate with the LLM provider
# [LOCAL DEVELOPMENT ONLY] Do not use it in production
AGENT_API_KEY=your_llm_api_key

# [REQUIRED] The LLM model used by Pydantic AI (e.g. qwen3.7-flash)
AGENT_MODEL=qwen3.7-flash

# [REQUIRED] Maximum amount of tokens allowed per agent run
AGENT_TOKEN_LIMIT=1000000

# [REQUIRED] Maximum number of *characters* the user can provide per instruction
AGENT_INSTRUCTION_LIMIT=200000

# [OPTIONAL] End-to-end deadline (seconds) for a single agent request
AGENT_REQUEST_TIMEOUT=60

# [OPTIONAL] Tool/output retries per agent run (each retry is a full LLM round-trip)
AGENT_RETRIES=1

# [OPTIONAL] Max concurrent agent executions per instance
AGENT_MAX_CONCURRENT_RUNS=3

# [OPTIONAL] LLM provider backend to be used by the conversational agent
AGENT_PROVIDER=alibaba

# [OPTIONAL] Override endpoint required for OpenAI compatible providers
AGENT_PROVIDER_BASE_URL=https://example.com

# ------------------------------------------------------------------------------
# LOGGING (env prefix: LOG_)
# ------------------------------------------------------------------------------
# [OPTIONAL] Global logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# [OPTIONAL] Enable structured JSON logging format
LOG_JSON_FORMAT=True
